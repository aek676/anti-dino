# @currentEnv=$NODE_ENV
# @defaultRequired=true @defaultSensitive=false
# @generateTsTypes(path=src/env.d.ts)
# @plugin(@varlock/bitwarden-plugin)
# @plugin(./varlock/time-zone-plugin.cjs)
# @initBitwarden(accessToken=$BITWARDEN_ACCESS_TOKEN)
# ---

# Machine account token for Bitwarden Secrets Manager.
# @sensitive @type=bitwardenAccessToken @required=not(forEnv(test))
# @docs(https://bitwarden.com/help/access-tokens/)
BITWARDEN_ACCESS_TOKEN=

# @type=enum(development, production, test)
NODE_ENV=development

# @type=port
PORT=3000

# Pino log level
# @type=enum(trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# Path Telegram POSTs updates to. Pick something unguessable.
# @type=string(startsWith=/) @example="/telegram/some-random-path"
WEBHOOK_PATH=

# Public base URL of this server, used to register the Telegram webhook
# @type=url @example="https://anti-dino.example.com"
PUBLIC_URL=

# From @BotFather, shaped like <bot-id>:<secret>
# @sensitive
# @docs(https://core.telegram.org/bots/api#authorizing-your-bot)
TELEGRAM_BOT_TOKEN=bitwarden("12b10052-6202-42a6-aeea-b4bf0118775e")

# Shared secret Telegram echoes back in x-telegram-bot-api-secret-token
# @sensitive
# @docs(https://core.telegram.org/bots/api#setwebhook)
TELEGRAM_WEBHOOK_SECRET=bitwarden("c55b712e-5d8c-4e8c-9a1b-b4bf01188eaf")

# Chat that receives availability and failure alerts
# @example="123456789"
ADMIN_CHAT_ID=

# @type=string @example="1394665"
FRESHA_LOCATION_ID=
# @type=number(isInt=true)
FRESHA_EMPLOYEE_ID=
# @example="sv:12345678"
FRESHA_SERVICE_ID=
# @type=url
FRESHA_BOOKING_URL=

# Watchdog
# @type=number(min=1, isInt=true)
CHECK_INTERVAL_MINUTES=5
# @type=timeZone @example="America/New_York"
SALON_TIME_ZONE=Europe/Madrid
# @type=number(min=1, max=31, isInt=true)
DAYS_AHEAD=31
# @type=number(min=0, isInt=true)
FRESHA_STEP_DELAY_MS=1500
# @type=number(min=1, isInt=true)
FAILURE_ALERT_THRESHOLD=5

# SQLite file, or :memory:
DATABASE_PATH=./data/anti-dino.sqlite
