{
  "name": "anti-dino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts | pino-pretty",
    "start": "bun run src/index.ts",
    "build": "bun build --compile --minify --target bun --outfile dist/server src/index.ts",
    "build:linux-x64": "bun build --compile --minify --target bun-linux-x64 --outfile dist/server-linux-x64 src/index.ts",
    "build:linux-arm64": "bun build --compile --minify --target bun-linux-arm64 --outfile dist/server-linux-arm64 src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "test": "bun test"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cron": "^1.4.2",
    "elysia": "^1.4.30",
    "grammy": "^1.46.0",
    "varlock": "^1.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "bun-types": "^1.4.0",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
