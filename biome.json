{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["src/**"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			"types": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnresolvedImports": "error",
				"noUndeclaredDependencies": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useExhaustiveSwitchCases": "error"
			},
			"style": {
				"useImportType": "error",
				"noNonNullAssertion": "error",
				"useNodejsImportProtocol": "error",
				"noProcessEnv": "error",
				"noExportedImports": "error",
				"useThrowOnlyError": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"pino": "Use the shared logger from @/utils/logger.",
							"@bogeychan/elysia-logger": "Use the shared logger from @/utils/logger."
						},
						"patterns": [
							{
								"group": ["@/modules/*/**"],
								"message": "Import a module only through its index (@/modules/<name>); use relative paths inside the module."
							},
							{
								"group": ["@/*"],
								"message": "Don't import loose files from the src/ root: put shared code in @/utils and feature code in @/modules."
							},
							{
								"group": ["../**"],
								"message": "Use the @/ alias instead of relative imports that leave the current directory."
							}
						]
					}
				},
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": true,
						"requireAscii": true,
						"conventions": [
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"match": "__typename|(.*)",
								"formats": ["camelCase", "snake_case"]
							},
							{
								"selector": {
									"kind": "typeProperty"
								},
								"match": "__typename|(.*)",
								"formats": ["camelCase", "snake_case"]
							}
						]
					}
				},
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"],
						"requireAscii": true,
						"strictCase": true
					}
				},
				"useConsistentTypeDefinitions": {
					"level": "error",
					"options": {
						"style": "type"
					}
				},
				"useConsistentArrayType": {
					"level": "error",
					"options": {
						"syntax": "shorthand"
					}
				},
				"noEnum": "error",
				"noParameterAssign": "error",
				"useDefaultParameterLast": "error",
				"noUselessElse": "error",
				"useCollapsedIf": "error",
				"useExplicitLengthCheck": "error",
				"useNumberNamespace": "error",
				"useAsConstAssertion": "error"
			},
			"suspicious": {
				"noConsole": "error",
				"noImportCycles": "error",
				"useAwait": "error",
				"useErrorMessage": "error",
				"noEmptyBlockStatements": "error",
				"noEvolvingTypes": "error",
				"noUnnecessaryConditions": "warn"
			},
			"performance": {
				"noReExportAll": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/modules/*/__test__/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"pino": "Use the shared logger from @/utils/logger.",
									"@bogeychan/elysia-logger": "Use the shared logger from @/utils/logger."
								},
								"patterns": [
									{
										"group": ["@/modules/*/**"],
										"message": "Import a module only through its index (@/modules/<name>); use relative paths inside the module."
									},
									{
										"group": ["@/*"],
										"message": "Don't import loose files from the src/ root: put shared code in @/utils and feature code in @/modules."
									},
									{
										"group": ["../../**"],
										"message": "Tests may reach their own module (../service) but not other modules' internals; use @/modules/<name>."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/index.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"pino": "Use the shared logger from @/utils/logger.",
									"@bogeychan/elysia-logger": "Use the shared logger from @/utils/logger."
								},
								"patterns": [
									{
										"group": ["@/modules/*/**"],
										"message": "Import a module only through its index (@/modules/<name>); use relative paths inside the module."
									},
									{
										"group": ["@/*"],
										"message": "Don't import loose files from the src/ root: put shared code in @/utils and feature code in @/modules."
									},
									{
										"group": ["../**"],
										"message": "Use the @/ alias instead of relative imports that leave the current directory."
									},
									{
										"group": ["./**"],
										"message": "The entrypoint must import through the @/ alias."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/utils/logger.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["src/utils/env.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": "off"
					}
				}
			}
		}
	]
}
